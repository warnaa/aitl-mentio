{
  "name": "mentio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev -w @mentio/app --",
    "build": "npm run build -w @mentio/app",
    "start": "npm run start -w @mentio/app --",
    "lint": "eslint",
    "typecheck": "tsc -p packages/core && tsc -p packages/db && tsc -p packages/ui && tsc -p packages/app && tsc -p tests/integration",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "audit": "node scripts/audit.mjs",
    "db:migration:create": "npm run migration:create -w @mentio/db --",
    "db:migrate": "npm run migrate -w @mentio/db",
    "db:migrate:down": "npm run migrate:down -w @mentio/db",
    "storybook": "npm run storybook -w @mentio/ui --",
    "build-storybook": "npm run build-storybook -w @mentio/ui",
    "test:storybook": "npm run test:storybook -w @mentio/ui",
    "check:tokens": "npm run check:tokens -w @mentio/ui",
    "docs:agent": "npm run docs:agent -w @mentio/ui",
    "check:agent-doc": "npm run check:agent-doc -w @mentio/ui"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "^0.39.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "testcontainers": "^12.2.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
