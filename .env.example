# PostgreSQL connection used by the app and the MikroORM CLI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentio

# Connection pool (per process).
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# Log SQL queries.
DB_DEBUG=false

# Session signing key for HS256 JWTs — at least 32 bytes. Generate with:
#   openssl rand -base64 32
# Optional at boot; session-protected routes fail closed (500) until it is set.
JWT_SECRET=

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Integration tests only (`npm run test:integration`), read from the shell — not from
# this file. Without it the suite starts Postgres via testcontainers (needs Docker).
# Point it at an empty, disposable database: the suite migrates and seeds it.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentio_it
