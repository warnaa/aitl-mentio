# Copy to `.env` and adjust. Consumed by @devmentor/core (app runtime) and the
# MikroORM CLI (@devmentor/db). Never commit the real `.env`.

# --- App ---
NODE_ENV=development
APP_NAME=DevMentor
LOG_LEVEL=info

# --- Database ---
# Either set DATABASE_URL (takes precedence) ...
# DATABASE_URL=postgres://devmentor:devmentor@127.0.0.1:5432/devmentor
# ... or the discrete DB_* vars below. Defaults match docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=devmentor
DB_USER=devmentor
DB_PASSWORD=devmentor

# --- Connection pool ---
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Set to "true" to log SQL.
DB_DEBUG=false

# --- Public URL ---
# Origin the app is served from; used to build OAuth callback and email links.
# APP_URL=http://localhost:3000

# --- Sessions ---
# HS256 signing key for session cookies and signed links, at least 32 characters.
# Generate with: openssl rand -base64 32
# Optional in development (sign-in reports "unavailable" until it is set);
# REQUIRED when NODE_ENV=production — the app refuses to serve without it.
# SESSION_SECRET=
# The previous key during a rotation; still accepted on verify, never used to sign.
# SESSION_SECRET_PREVIOUS=

# --- GitHub sign-in ---
# OAuth app credentials. Optional: without them GitHub sign-in reports "unavailable"
# and the rest of the app still runs.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Authorization ---
# Comma-separated operator allowlist, matched case-insensitively against a user's
# verified email on every request. Empty means nobody is an operator.
# OPERATOR_EMAILS=founder@example.com,cofounder@example.com
# Reverse proxies in front of the app whose X-Forwarded-For entry is trusted when
# rate limiting by client IP. Leave 0 when nothing proxies the app.
# TRUSTED_PROXY_HOPS=0

# --- Mail (Resend HTTP API) ---
# MAIL_API_KEY=
# MAIL_FROM=DevMentor <no-reply@example.com>

# --- Adapter selection ---
# AUTH_IDENTITY_ADAPTER: github (default) or mock. MAILER_ADAPTER: resend or log;
# left unset it is chosen per environment. The fakes (mock, log) exist for the
# integration harness only: the app refuses to start with either of them unless
# INTEGRATION_TEST_RUN=1 is set as well.
# AUTH_IDENTITY_ADAPTER=github
# MAILER_ADAPTER=resend
# INTEGRATION_TEST_RUN=0
