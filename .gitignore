# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/packages/app/next-env.d.ts
/.next/
**/.next/
/out/
**/out/

# production
/build
**/dist/
**/storybook-static/
**/debug-storybook.log

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# IDE
.idea

# vercel
.vercel

# typescript
*.tsbuildinfo

# Disposable test-environment state; sanitized QA reports/evidence are committed.
.ai/qa/test-env.json
.ai/qa/test-env.env
.ai/qa/test-env-build-cache.json
.ai/qa/test-env-browser.json
.ai/qa/test-env.lock/
.ai/qa/test-env-runtime/

# skills installer staging copy (unrendered upstream download of .agents/skills)
/agent/

# per-developer Claude Code settings
.claude/settings.local.json

# generated local Storybook prototype
packages/ui/.storybook/public/prototypes/
