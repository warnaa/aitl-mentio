# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# integration test artifacts (server log, failure screenshots)
/tests/integration/.artifacts

# agent QA run state (generated per run; .ai/scripts launchers stay committed)
/.ai/qa/artifacts_*/
/.ai/qa/test-env.json
/.ai/qa/test-env.env

# Local Storybook output
/packages/ui/storybook-static/
/packages/ui/coverage/
/packages/ui/.storybook/public/prototypes/
